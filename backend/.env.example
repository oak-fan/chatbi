# cogmait-chatbi 环境变量（与 cogmait-backend-v2 共用同一套数据库配置）

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
SQL_ECHO=false

# 与 cogmait-backend-v2 保持一致
DATABASE_URL=postgresql+asyncpg://root:123456@localhost:5432/cogmait_base
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=

# 无鉴权模式下的默认操作者
DEFAULT_USER_ID=1
DEFAULT_USERNAME=chatbi

# LiteLLM / 默认模型（独立运行时通过 env 配置，不再依赖 main_api 系统参数）
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-test
DEFAULT_COMPLETION_MODEL=litellm_proxy/your-completion-model
DEFAULT_EMBEDDING_MODEL=litellm_proxy/your-embedding-model

# 向量存储
VECTOR_BACKEND=postgres
VECTOR_DIMENSIONS=1024

# ChatBI 专用配置（与 cogmait-backend-v2 一致）
CHATBI_DATASOURCE_CREDENTIAL_ENCRYPTION_KEY=replace-me-generate-random-secret
CHATBI_FILE_UPLOAD_DATABASE_URL=postgresql+asyncpg://cogmait:cogmait@localhost:5432/cogmait_chatbi
CHATBI_BENCHMARK_ROOT=
CHATBI_BIRD_MINIDEV_ROOT=
CHATBI_KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://postgres:password@host:port/postgres

# 服务端口
HOST=0.0.0.0
PORT=8001

# 可观测性（默认关闭外部上报）
OBSERVABILITY_PROVIDER=noop
